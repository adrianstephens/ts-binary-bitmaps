{
	"name": "@isopodlabs/binary_bitmaps",
	"description": "A package for reading various bitmap file format with TypeScript.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrianstephens/ts-binary-bitmaps.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./arch": "./dist/arch.js",
		"./clr": "./dist/clr.js",
		"./CompoundDocument": "./dist/CompoundDocument.js",
		"./elf": "./dist/elf.js",
		"./mach": "./dist/mach.js",
		"./pe": "./dist/pe.js",
		"./tar": "./dist/tar.js",
		"./zip": "./dist/zip.js"
	},
	"files": [
		"dist/**/*.{js,d.ts}",
		"README.md"
	],
	"scripts": {
		"prepare": "ts-patch install && copy-file node_modules/@isopodlabs/binary/scripts/transform.ts scripts/transform.ts",
		"build": "tsc",
		"watch": "tsc --watch -p ./",
		"lint": "eslint \"src/**/*.ts\"",
		"link": "npm link @isopodlabs/binary",
		"update": "npm install @isopodlabs/binary@latest"
	},
	"keywords": [
		"binary",
		"typescript",
		"bitmap",
		"jpg",
		"png",
		"bmp",
		"dds",
		"gif"
	],
	"author": "Adrian Stephens",
	"license": "MIT",
	"version": "1.10.0",
	"dependencies": {
		"@isopodlabs/binary": "^2.0.1"
	}
}
